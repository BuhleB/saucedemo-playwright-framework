{
  "name": "saucedemo-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript end-to-end suite for the SauceDemo practice shop: login, catalogue, cart and checkout order flow.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:saucedemo": "playwright test --grep-invert @external",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5"
  }
}
